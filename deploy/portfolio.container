[Unit]
Description=Portfolio (armandonetto.com) - FastAPI + React
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/armandonettox/portfolio:latest
ContainerName=portfolio
# so em loopback: o nginx do host faz o proxy (o rootlessport nao aceita conexao externa no NAT da Oracle)
PublishPort=127.0.0.1:8006:8000
# GITHUB_TOKEN (leitura) fica neste arquivo, fora da imagem e fora do git
EnvironmentFile=/home/ubuntu/portfolio.env
# ultima lista boa de projetos e posts, guardada no servidor para sobreviver aos reinicios
Volume=/home/ubuntu/portfolio-data:/app/cache:U

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
